{
  "name": "@mka/gate-sdk",
  "version": "1.0.0",
  "description": "Framework-optional client, server, and React helpers for the MKA token gate",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./react": {
      "import": {
        "types": "./dist/react.d.ts",
        "default": "./dist/react.js"
      },
      "require": {
        "types": "./dist/react.d.cts",
        "default": "./dist/react.cjs"
      }
    },
    "./server": {
      "import": {
        "types": "./dist/server.d.ts",
        "default": "./dist/server.js"
      },
      "require": {
        "types": "./dist/server.d.cts",
        "default": "./dist/server.cjs"
      }
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsup",
    "test": "vitest run --config vitest.config.ts"
  },
  "dependencies": {
    "ethers": "6.17.0"
  },
  "peerDependencies": {
    "express": ">=4",
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "express": { "optional": true },
    "react": { "optional": true }
  },
  "devDependencies": {
    "@testing-library/react": "16.3.0",
    "@types/express": "4.17.21",
    "@types/node": "22.10.2",
    "@types/react": "19.1.8",
    "@types/react-dom": "19.1.7",
    "jsdom": "26.1.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "tsup": "8.5.0",
    "typescript": "5.7.2",
    "vitest": "3.2.4"
  }
}