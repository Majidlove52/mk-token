{
  "name": "mka-token",
  "version": "1.0.0",
  "private": true,
  "description": "MK Alpha (MKA) contracts for BNB Chain",
  "scripts": {
    "compile": "hardhat compile",
    "test": "hardhat test && npm run test:monitor",
    "coverage": "hardhat coverage",
    "start:gate": "ts-node gate/src/server.ts",
    "test:monitor": "mocha --require ts-node/register --extension ts \"monitor/test/**/*.test.ts\"",
    "monitor": "ts-node monitor/src/monitor.ts",
    "build:monitor": "tsc -p monitor/tsconfig.json"
  },
  "dependencies": {
    "cors": "2.8.5",
    "ethers": "6.17.0",
    "express": "4.21.2",
    "express-rate-limit": "7.5.0"
  },
  "devDependencies": {
    "@types/cors": "2.8.17",
    "@types/express": "4.17.21",
    "@nomicfoundation/hardhat-toolbox": "6.1.0",
    "@openzeppelin/contracts": "5.1.0",
    "dotenv": "16.4.7",
    "hardhat": "2.28.0",
    "solidity-coverage": "0.8.16",
    "ts-node": "10.9.2",
    "typescript": "5.7.2"
  }
}